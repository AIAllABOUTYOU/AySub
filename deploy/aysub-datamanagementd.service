[Unit]
Description=AySub Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=aysub
Group=aysub
WorkingDirectory=/opt/aysub
ExecStart=/opt/aysub/datamanagementd \
  -socket-path /tmp/aysub-datamanagement.sock \
  -sqlite-path /var/lib/aysub/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
